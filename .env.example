# Telegram bot token from @BotFather
BOT_TOKEN=

# FatSecret API credentials (https://platform.fatsecret.com)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_REGION=US
FATSECRET_LANGUAGE=en

# Gemini Vision API key (for photo food recognition)
GEMINI_API_KEY=

# AI / LLM configuration (OpenAI-compatible endpoint, fallback)
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o

# Database — defaults to SQLite if left empty
# For PostgreSQL: postgresql://fatsecret:<password>@db:5432/fatsecret_bot
# DATABASE_URL=

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Скопируй в .env и заполни. .env в .gitignore и не коммитится.

# --- FatSecret: у OAuth 1.0 и OAuth 2.0 РАЗНЫЕ пары ключей ---

# OAuth 1.0 (Consumer Key / Consumer Secret) — ОБЯЗАТЕЛЬНО.
# Закрывает и поиск продуктов (двуногая подпись), и доступ к дневнику конкретного
# пользователя (трёхногая) — а дневник существует только в OAuth 1.0.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# OAuth 2.0 (Client ID / Client Secret) — необязательно, боту не нужны.
# Полезны только для диагностики: по выданным scope видно, какой у аккаунта тариф
# (см. spike/check_fatsecret.py). Запросы по OAuth 2.0 требуют IP в IP Restrictions.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# openrouter.ai → Keys
OPENROUTER_API_KEY=

# По умолчанию — роутер openrouter/free: сам подбирает бесплатную модель под запрос.
# Через запятую можно задать цепочку: бот идёт по списку сверху вниз, пока не получит
# разбираемый ответ. Пример с платным запасным вариантом (~$0.00008 за фото):
# OPENROUTER_TEXT_MODELS=openrouter/free,qwen/qwen3.7-flash
# OPENROUTER_VISION_MODELS=openrouter/free,qwen/qwen3.7-flash

# @BotFather
TELEGRAM_BOT_TOKEN=

# Твой Telegram user_id — единственный, кому доступна команда /allow
BOT_OWNER_ID=

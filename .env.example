# Telegram bot token from @BotFather
BOT_TOKEN=

# FatSecret API credentials (https://platform.fatsecret.com)
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_REGION=US
FATSECRET_LANGUAGE=en

# AI / LLM configuration (OpenAI-compatible endpoint)
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o

# Gemini Vision API key (for food photo recognition)
# Falls back to AI_API_KEY if unset when using Gemini models
GEMINI_API_KEY=

# Database — defaults to SQLite if left empty
# For PostgreSQL: postgresql://user:***@host:5432/fatsecret_bot
# DATABASE_URL=

# Logging
LOG_LEVEL=INFO
DEBUG=false

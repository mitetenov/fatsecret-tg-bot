# Скопируй в .env и заполни. .env в .gitignore и не коммитится.

# --- FatSecret: у OAuth 1.0 и OAuth 2.0 РАЗНЫЕ пары ключей ---

# OAuth 1.0 (Consumer Key / Consumer Secret) — ОБЯЗАТЕЛЬНО.
# Закрывает и поиск продуктов (двуногая подпись), и доступ к дневнику конкретного
# пользователя (трёхногая) — а дневник существует только в OAuth 1.0.
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# OAuth 2.0 (Client ID / Client Secret) — необязательно, боту не нужны.
# Полезны только для диагностики: по выданным scope видно, какой у аккаунта тариф
# Диагностика OAuth 2.0 требует IP в IP Restrictions; Go-бот эти ключи не читает.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# LLM: openrouter (по умолчанию) или zai. Нужен только ключ выбранного провайдера.
# LLM_PROVIDER=openrouter

# OpenRouter: openrouter.ai → Keys
OPENROUTER_API_KEY=

# По умолчанию: google/gemini-3.5-flash-lite, запасной — бесплатный роутер.
# Бот идёт по цепочке сверху вниз, пока не получит разбираемый ответ.
# OPENROUTER_TEXT_MODELS=google/gemini-3.5-flash-lite,openrouter/free
# OPENROUTER_VISION_MODELS=google/gemini-3.5-flash-lite,openrouter/free

# Z.AI напрямую: задай LLM_PROVIDER=zai и ключ обычного Model API.
# https://api.z.ai/api/paas/v4/chat/completions
ZAI_API_KEY=
# Одна модель для текста, фотографий, перевода и поиска товаров.
# ZAI_MODEL=glm-5.3-flash
# Глубина рассуждений: low, high или max. По умолчанию low для коротких запросов.
# ZAI_REASONING_EFFORT=low

# @BotFather
TELEGRAM_BOT_TOKEN=

# Твой Telegram user_id — единственный, кому доступна команда /allow
BOT_OWNER_ID=

# Необязательно: часовой пояс по умолчанию и каталог SQLite/heartbeat.
# FSBOT_DEFAULT_TZ=Asia/Tbilisi
# FSBOT_STATE_DIR=/data
